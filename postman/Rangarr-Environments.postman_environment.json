{
  "id": "rangarr-api-environments",
  "name": "Rangarr Environments",
  "description": "Environment configurations for Rangarr API testing",
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      }
    ]
  },
  "environments": [
    {
      "id": "dev-env",
      "name": "Development",
      "description": "Local development environment",
      "values": [
        {
          "key": "base_url",
          "value": "http://localhost:9000",
          "type": "string",
          "enabled": true
        },
        {
          "key": "api_key",
          "value": "rangarr-default-key",
          "type": "string",
          "enabled": true
        },
        {
          "key": "poll_interval_ms",
          "value": "2000",
          "type": "string",
          "enabled": true
        }
      ]
    },
    {
      "id": "prod-env",
      "name": "Production",
      "description": "Production environment template. Update values for your deployment.",
      "values": [
        {
          "key": "base_url",
          "value": "http://rangarr.example.com:9000",
          "type": "string",
          "enabled": true
        },
        {
          "key": "api_key",
          "value": "your-production-api-key-here",
          "type": "string",
          "enabled": true
        },
        {
          "key": "poll_interval_ms",
          "value": "2000",
          "type": "string",
          "enabled": true
        }
      ]
    }
  ]
}
