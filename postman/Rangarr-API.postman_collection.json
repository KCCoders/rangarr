    {
      "name": "Control & Actions",
      "description": "Manual control and search triggering",
      "item": [
        {
          "name": "POST /api/search/trigger",
          "description": "Manually trigger a search cycle for specific instances or all enabled instances.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"missing\",\n  \"instances\": [\"Radarr-Movies\"],\n  \"dry_run\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/search/trigger",
              "host": ["{{base_url}}"],
              "path": ["api", "search", "trigger"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Api-Key",
                    "value": "{{api_key}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"type\": \"missing\",\n  \"instances\": [\"Radarr-Movies\"],\n  \"dry_run\": false\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/search/trigger",
