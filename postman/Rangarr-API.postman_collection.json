    {
      "name": "Configuration",
      "description": "Configuration endpoints",
      "item": [
        {
          "name": "GET /api/config",
          "description": "Current configuration with secrets redacted. Shows global settings and all configured instances.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/config",
              "host": ["{{base_url}}"],
              "path": ["api", "config"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Api-Key",
                    "value": "{{api_key}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/config",
                  "host": ["{{base_url}}"],
                  "path": ["api", "config"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"global\": {\n    \"interval_minutes\": 60,\n    \"interval_missing_minutes\": 30,\n    \"interval_upgrade_minutes\": 120,\n    \"missing_batch_size\": 20,\n    \"upgrade_batch_size\": 10,\n    \"stagger_interval_seconds\": 30,\n    \"search_order\": \"last_searched_ascending\",\n    \"active_hours\": \"22:00-06:00\",\n    \"dry_run\": false,\n    \"interleave_instances\": false,\n    \"interleave_types\": true,\n    \"retry_interval_days\": 30,\n    \"max_queue_size\": 0,\n    \"season_packs\": false\n  },\n  \"instances\": [\n    {\n      \"name\": \"Radarr-Movies\",\n      \"type\": \"radarr\",\n      \"host\": \"http://radarr:7878\",\n      \"enabled\": true,\n      \"weight\": 1.5,\n      \"max_queue_size\": 20,\n      \"api_key\": \"***REDACTED***\"\n    }\n  ]\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Logs & Monitoring",
      "description": "Log retrieval and filtering",
      "item": [
        {
          "name": "GET /api/logs (basic)",
          "description": "Retrieve recent log lines. Default: 100 lines, INFO level and above.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/logs",
              "host": ["{{base_url}}"],
              "path": ["api", "logs"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Api-Key",
                    "value": "{{api_key}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/logs",
                  "host": ["{{base_url}}"],
                  "path": ["api", "logs"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"logs\": [\n    {\n      \"timestamp\": \"2026-07-18T14:23:45Z\",\n      \"level\": \"INFO\",\n      \"instance\": \"Radarr-Movies\",\n      \"message\": \"Searching (missing): The Matrix (1/5)\"\n    }\n  ],\n  \"total_count\": 1523,\n  \"returned\": 100\n}"
            }
          ]
        },
        {
          "name": "GET /api/logs (with level filter)",
          "description": "Filter logs by level (DEBUG, INFO, WARNING, ERROR)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/logs?lines=50&level=WARNING",
              "host": ["{{base_url}}"],
              "path": ["api", "logs"],
              "query": [
                {
                  "key": "lines",
                  "value": "50"
                },
                {
                  "key": "level",
                  "value": "WARNING"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/logs (with search)",
          "description": "Search logs by substring match",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/logs?lines=100&search=searched",
              "host": ["{{base_url}}"],
              "path": ["api", "logs"],
              "query": [
                {
                  "key": "lines",
                  "value": "100"
                },
                {
                  "key": "search",
                  "value": "searched"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/logs (by instance)",
          "description": "Filter logs by instance name",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/logs?instance=Radarr-Movies&lines=50",
              "host": ["{{base_url}}"],
              "path": ["api", "logs"],
              "query": [
                {
                  "key": "instance",
                  "value": "Radarr-Movies"
                },
                {
                  "key": "lines",
                  "value": "50"
                }
              ]
            }
          }
        }
      ]
    },
